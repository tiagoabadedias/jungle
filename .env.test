# Carregado automaticamente pelo `bun test` (NODE_ENV=test). Banco isolado dos testes.
DATABASE_URL=postgres://wagering_app:wagering_app@localhost:55432/wagering_test
DATABASE_MIGRATION_URL=postgres://wagering:wagering@localhost:55432/wagering_test
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
# Workers desligados no app dos testes HTTP: os testes de mensageria montam consumers/publishers
# com filas próprias (nomes aleatórios) para não disputar mensagens com o app do compose.
SQS_CONSUMER_ENABLED=false
OUTBOX_PUBLISHER_ENABLED=false
PENDING_REFERENCE_WORKER_ENABLED=false
LOG_LEVEL=error
